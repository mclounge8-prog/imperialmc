# --- PostgreSQL (используется контейнером postgres) ---
POSTGRES_USER=imperialmc
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=imperial_mc

# --- Приложение (Hono) ---
PORT=3000
# Хост "postgres" — это имя сервиса в docker-compose, не localhost
DATABASE_URL=postgres://imperialmc:CHANGE_ME@postgres:5432/imperial_mc

# Сгенерировать: openssl rand -hex 32
JWT_SECRET=CHANGE_ME
