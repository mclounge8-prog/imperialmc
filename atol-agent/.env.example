# URL вашего backend (без слэша на конце)
BACKEND_URL=https://your-backend-domain.example

# Токен агента — берётся в бэкофисе: Заведения -> нужное заведение -> "Касса АТОЛ" -> "Создать токен"
AGENT_TOKEN=

# Настройки подключения к кассе АТОЛ по TCP/IP (касса и этот ПК должны быть в одной локальной сети)
KKT_IP=192.168.1.50
KKT_PORT=5555

# Числовой код модели кассы для драйвера ДТО10 — смотрите в утилите
# "Тест драйвера ККТ" -> Свойства -> Общие -> Модель, при поиске/подключении вашей кассы
KKT_MODEL=

# Как часто опрашивать backend за новыми заданиями, мс
POLL_INTERVAL_MS=3000
